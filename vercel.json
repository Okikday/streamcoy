{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "flutter build web --release --base-href /",
  "outputDirectory": "build/web",
  "installCommand": "git clone -b stable https://github.com/flutter/flutter.git flutter-sdk && export PATH=\"$PWD/flutter-sdk/bin:$PATH\" && flutter precache --web && flutter pub get",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
